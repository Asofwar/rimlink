<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Raiders sent by another player: a hidden, permanently hostile faction that the game never generates on its own.
       The pawns come from the attacker's blobs; this def only gives them a faction to fight under. -->
  <FactionDef ParentName="FactionBase">
    <defName>RimlinkRaiders</defName>
    <label>player raiders</label>
    <description>Colonists sent by another player of this server to raid your colony.</description>
    <pawnSingular>raider</pawnSingular>
    <pawnsPlural>raiders</pawnsPlural>
    <categoryTag>Outlander</categoryTag>
    <fixedName>Rimlink raiders</fixedName>
    <hidden>true</hidden>
    <permanentEnemy>true</permanentEnemy>
    <autoFlee>true</autoFlee>
    <humanlikeFaction>true</humanlikeFaction>
    <techLevel>Industrial</techLevel>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <displayInFactionSelection>false</displayInFactionSelection>
    <canMakeRandomly>false</canMakeRandomly>
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <raidsForbidden>true</raidsForbidden>
    <factionIconPath>World/WorldObjects/Expanding/Sites/DownedRefugee</factionIconPath>
    <backstoryFilters>
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
      </li>
    </backstoryFilters>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <Villager>10</Villager>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
