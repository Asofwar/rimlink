<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <AssemblyName>rimlink-discord</AssemblyName>
    <RootNamespace>Rimlink.Discord</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Discord.Net" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Strings\Strings.*.json" />
    <!-- Manifest names Rimlink.Discord.Strings.Strings.<language>.json, read by Text/Strings.cs. WithCulture=false: ".en"
         in the file name is not a satellite-assembly culture here. -->
    <EmbeddedResource Include="Strings\Strings.*.json" WithCulture="false" />
    <Content Include="Strings\commands.*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rimlink.Discord.Tests" />
  </ItemGroup>
</Project>
