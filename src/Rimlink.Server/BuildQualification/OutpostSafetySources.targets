<Project>
  <PropertyGroup>
    <_OutpostSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</_OutpostSourceRoot>
  </PropertyGroup>
  <Target Name="GenerateOutpostSafetySourceManifest" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_OutpostSafetySource Include="$(_OutpostSourceRoot)src/Rimlink.Server/Application/Outposts/SchemaProfiles/*.json" />
      <_OutpostSafetySource Include="$(_OutpostSourceRoot)src/**/*.cs;$(_OutpostSourceRoot)src/**/*.proto;$(_OutpostSourceRoot)src/**/*.csproj;$(_OutpostSourceRoot)src/**/*.targets;$(_OutpostSourceRoot)src/Rimlink.Server/wwwroot/**/*;$(_OutpostSourceRoot)mod/**/*;$(_OutpostSourceRoot)scripts/*;$(_OutpostSourceRoot)tools/Rimlink.OutpostAcceptanceHost/**/*.cs;$(_OutpostSourceRoot)tools/Rimlink.OutpostAcceptanceHost/**/*.csproj;$(_OutpostSourceRoot)tools/Rimlink.BridgeTools/**/*.cs;$(_OutpostSourceRoot)tools/Rimlink.BridgeTools/*.csproj;$(_OutpostSourceRoot)Directory.Build.props;$(_OutpostSourceRoot)Directory.Packages.props;$(_OutpostSourceRoot)global.json"
        Exclude="$(_OutpostSourceRoot)**/bin/**;$(_OutpostSourceRoot)**/obj/**;$(_OutpostSourceRoot)**/node_modules/**;$(_OutpostSourceRoot)mod/Assemblies/**" />
    </ItemGroup>
    <GetFileHash Files="@(_OutpostSafetySource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_OutpostHashedSource" />
    </GetFileHash>
    <ItemGroup>
      <_OutpostHashedSource>
        <SourceKey>$([System.String]::Copy('$([MSBuild]::MakeRelative('$(_OutpostSourceRoot)', '%(FullPath)'))').Replace('\', '/'))</SourceKey>
      </_OutpostHashedSource>
    </ItemGroup>
    <!-- Qualification is deliberately outside this source inventory: sealing cannot change its own source identity. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)outpost-safety-sources.txt" Lines="@(_OutpostHashedSource->'%(SourceKey)|%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)outpost-safety-sources.txt" LogicalName="Rimlink.Outposts.SafetySources" />
    </ItemGroup>
  </Target>
</Project>
