<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Rimlink.Server</RootNamespace>
    <AssemblyName>rimlink-server</AssemblyName>
    <UserSecretsId>rimlink-server</UserSecretsId>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="prometheus-net.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="ZstdSharp.Port" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rimlink.Protocol\Rimlink.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Rimlink.Server.Tests" />
    <InternalsVisibleTo Include="Rimlink.OutpostAcceptanceHost" />
    <InternalsVisibleTo Include="Rimlink.GuildAcceptanceHost" />
    <EmbeddedResource Include="BuildQualification/qualification.json" LogicalName="Rimlink.Outposts.Qualification" />
    <EmbeddedResource Include="BuildQualification/guild-qualification.json" LogicalName="Rimlink.GuildCapture.Qualification" />
    <EmbeddedResource Include="Application/Outposts/SchemaProfiles/qualification.json" LogicalName="Rimlink.OutpostSchema.qualification.json" />
    <EmbeddedResource Include="Application/Outposts/SchemaProfiles/qualification-runtime14.json" LogicalName="Rimlink.OutpostSchema.qualification-runtime14.json" />
    <EmbeddedResource Include="Application/Outposts/SchemaProfiles/v1-crlf.json" LogicalName="Rimlink.OutpostSchema.v1-crlf.json" />
    <EmbeddedResource Include="Application/Outposts/SchemaProfiles/v1-lf.json" LogicalName="Rimlink.OutpostSchema.v1-lf.json" />
    <EmbeddedResource Include="Application/Outposts/SchemaProfiles/v2-crlf-crlf.json" LogicalName="Rimlink.OutpostSchema.v2-crlf-crlf.json" />
    <EmbeddedResource Include="Application/Outposts/SchemaProfiles/v2-lf-lf.json" LogicalName="Rimlink.OutpostSchema.v2-lf-lf.json" />
    <EmbeddedResource Include="Application/Outposts/SchemaProfiles/v2-crlf-lf.json" LogicalName="Rimlink.OutpostSchema.v2-crlf-lf.json" />
    <EmbeddedResource Include="Application/Outposts/SchemaProfiles/v2-lf-crlf.json" LogicalName="Rimlink.OutpostSchema.v2-lf-crlf.json" />
    <EmbeddedResource Include="Application/Outposts/SchemaProfiles/v3-*.json" LogicalName="Rimlink.OutpostSchema.%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="BuildQualification/OutpostSafetySources.targets" />
</Project>
