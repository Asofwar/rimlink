{
  "Server": {
    "Port": 25560,
    "DataDir": "./data",
    "MaxPlayers": 50,
    "MaxSettlementsPerPlayer": 1
  },
  "Tls": {
    "Required": true
  },
  "Auth": {
    "AllowPassword": false,
    "AdminSteamIds": [],
    "AdminLogins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
